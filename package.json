{
    "name": "@mat3ra/prove",
    "version": "0.0.0",
    "description": "Property visualization components for Mat3ra workflow ecosystem",
    "scripts": {
        "test": "nyc --reporter=text mocha --recursive --bail --require @babel/register/lib --require tests/setup.js tests",
        "lint": "eslint src tests",
        "lint:fix": "eslint --fix --cache src tests && prettier --write src tests",
        "start": "vite",
        "build": "npm run transpile && vite build",
        "preview": "vite preview",
        "transpile": "tsc",
        "prettier": "prettier --check src tests",
        "prepare": "husky install",
        "prepublishOnly": "npm run transpile"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mat3ra/prove.git"
    },
    "main": "dist/exports.js",
    "types": "dist/exports.d.ts",
    "files": [
        "/dist",
        "/src",
        "tsconfig.json"
    ],
    "author": "Exabyte Inc.",
    "bugs": {
        "url": "https://github.com/mat3ra/prove/issues"
    },
    "license": "Apache-2.0",
    "homepage": "https://github.com/mat3ra/prove",
    "dependencies": {
        "@mui/styles": "^5.18.0",
        "highcharts": "^6.2.0",
        "highcharts-more": "^0.1.7",
        "highcharts-react-official": "^3.2.3",
        "lodash": "^4.18.1",
        "prop-types": "^15.8.1",
        "underscore.string": "^3.3.6"
    },
    "peerDependencies": {
        "@mat3ra/code": "*",
        "@mat3ra/cove": "*",
        "@mat3ra/esse": "*",
        "@mat3ra/made": "*",
        "@mat3ra/prode": "*",
        "@mat3ra/utils": "*",
        "@mat3ra/wode": "*",
        "@mui/material": "*",
        "@types/react": "*",
        "react": "*",
        "react-dom": "*"
    },
    "devDependencies": {
        "@babel/cli": "7.29.7",
        "@babel/core": "^7.29.13",
        "@babel/eslint-parser": "^7.29.13",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/preset-env": "^7.29.14",
        "@babel/preset-react": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@babel/register": "^7.29.13",
        "@babel/runtime-corejs3": "^7.29.15",
        "@emotion/babel-plugin": "^11.13.5",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mat3ra/eslint-config": "^2026.7.12-0",
        "@mat3ra/ade": "2026.8.18-0",
        "@mat3ra/code": "^2026.11.25-0",
        "@mat3ra/cove": "2026.11.17-1",
        "@mat3ra/esse": "^2026.11.25-0",
        "@mat3ra/ide": "^2026.11.25-0",
        "@mat3ra/made": "^2026.11.25-0",
        "@mat3ra/mode": "^2026.11.25-0",
        "@mat3ra/prode": "^2026.11.25-0",
        "@mat3ra/standata": "2026.11.20-0",
        "@mat3ra/tsconfig": "^2024.6.3-0",
        "@mat3ra/utils": "2026.11.6-0",
        "@mat3ra/wode": "2026.11.17-0",
        "@mui/icons-material": "^5.18.0",
        "@mui/material": "^5.18.0",
        "@types/react": "^17.0.93",
        "@types/react-dom": "^17.0.26",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "@vitejs/plugin-react": "^4.7.0",
        "chai": "^4.5.0",
        "eslint": "^7.32.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-prettier": "^8.10.2",
        "eslint-import-resolver-exports": "^1.0.0-beta.5",
        "eslint-import-resolver-meteor": "^0.4.0",
        "eslint-import-resolver-node": "^0.4.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^50.8.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-mui-path-imports": "^0.0.15",
        "eslint-plugin-prettier": "^4.2.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-import-sort": "^7.0.0",
        "husky": "^7.0.4",
        "lint-staged": "^12.5.0",
        "mocha": "10.8.2",
        "nyc": "^15.1.0",
        "prettier": "^2.8.8",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "typescript": "^4.9.5",
        "vite": "^6.4.6",
        "vite-plugin-node-polyfills": "^0.28.0"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,!dist/**/*}": "eslint --cache --fix",
        "*.{js,jsx,ts,tsx,css,!dist/**/*}": "prettier --write"
    }
}
